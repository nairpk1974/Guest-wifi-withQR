# Bessel Guest Wi-Fi reverse proxy. ${ADMIN_HOST} / ${GUEST_HOST} / ${HTTPS_PORT} are substituted at container start.
# HTTPS_PORT is the HOST port (container always listens on 443) - used only to build redirects.
server_tokens off;
client_max_body_size 1m;

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=guest:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream backend  { server backend:8000; keepalive 16; }
upstream frontend { server frontend:8080; }

ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# ---------- HTTP -> HTTPS ----------
server {
    listen 80 default_server;
    server_name _;
    location / { return 301 https://$host:${HTTPS_PORT}$request_uri; }
}

# ---------- anything else on 443: drop ----------
server {
    listen 443 ssl default_server;
    server_name _;
    return 444;
}

# ---------- Administrator / Reception console (corporate LAN only) ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_HOST};

    include /etc/nginx/admin-allow.conf;   # allow <corporate CIDRs>; deny all;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";

    location = /api/auth/login { limit_req zone=login burst=5 nodelay; proxy_pass http://backend; }
    location = /api/auth/mfa   { limit_req zone=login burst=5 nodelay; proxy_pass http://backend; }
    location /api/             { limit_req zone=api burst=40 nodelay; proxy_pass http://backend; proxy_read_timeout 120s; }
    location /internal/        { return 404; }
    location /                 { proxy_pass http://frontend; }
}

# ---------- Guest captive portal (reachable from guest VLANs, pre-authentication) ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${GUEST_HOST};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";

    # Only the guest pages are published on this hostname - no admin UI, no /api, no /internal.
    location ^~ /q/            { limit_req zone=guest burst=10 nodelay; proxy_pass http://backend; }
    location = /portal         { limit_req zone=guest burst=20 nodelay; proxy_pass http://backend; }
    location = /portal/code    { limit_req zone=guest burst=5 nodelay;  proxy_pass http://backend; }
    location ^~ /portal/       { limit_req zone=guest burst=20 nodelay; proxy_pass http://backend; }
    location ^~ /static/guest/ { proxy_pass http://backend; expires 1h; }
    location = /               { return 302 /portal/status; }
    location /                 { return 404; }
}
