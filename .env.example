# ============================================================================
# Bessel Guest Wi-Fi - environment. Copy to .env (chmod 600). NEVER commit .env.
# Secrets marked <generated> are filled by scripts/gen-secrets.sh.
# Values marked <discovery> must come from the verified device configuration.
# ============================================================================
APP_VERSION=1.0.0

# --- Hostnames (must match the TLS certificate in deploy/certs/) ---
ADMIN_HOST=wifi-admin.example.com          # <decision> admin console hostname (corporate DNS)
GUEST_HOST=guest.example.com               # <decision> guest portal hostname (needs publicly trusted cert)
HTTP_BIND_IP=0.0.0.0                       # or the server IP that serves the portal
HTTPS_PORT=443                             # host port for HTTPS (Docker-vm 192.168.0.10: 8444 - 443 is used by another app)
HTTP_PORT=80                               # host port for HTTP->HTTPS redirect (Docker-vm: 8088)

# --- Secrets ---
POSTGRES_PASSWORD=                         # <generated>
DATA_ENCRYPTION_KEY=                       # <generated> Fernet key - back it up with the DB backups!
RADIUS_API_KEY=                            # <generated> FreeRADIUS -> backend
RADIUS_SECRET_BLR=                         # <generated> also entered on FortiGate 60F 'config user radius'
RADIUS_SECRET_HYD=                         # <generated> also entered on FortiGate 30G 'config user radius'
RADIUS_SECRET_LOCAL=                       # <generated> container health check only
COA_SECRET_BLR=                            # <generated> = RADIUS_SECRET_BLR unless FortiGate uses a separate CoA secret
COA_SECRET_HYD=                            # <generated>

# --- FortiGate RADIUS client source addresses ---
FGT_BLR_RADIUS_SOURCE_IP=192.0.2.1         # <discovery> placeholder (TEST-NET) until verified
FGT_HYD_RADIUS_SOURCE_IP=192.0.2.2         # <discovery> placeholder (TEST-NET) until verified
RADIUS_BIND_IP=0.0.0.0

# --- Policy ---
MFA_ENFORCED=true
REQUIRE_SEPARATE_APPROVER=false            # true = registrar cannot approve own request
ALLOWED_DURATIONS_HOURS=1,4,8,12
QR_REDEEM_WINDOW_MINUTES=120               # same-day passes must be scanned within this window
CAPTIVE_TRIGGER_URL=http://neverssl.com/   # any plain-HTTP site the FortiGate will intercept
RADIUS_GROUP_NAME=BESSEL-GUEST             # must match the FortiGate user group's RADIUS group-name match
SESSION_IDLE_MINUTES=30
GUEST_PII_RETENTION_DAYS=180               # <decision> confirm with legal/compliance
LOG_RETENTION_DAYS=365                     # <decision> confirm with legal/compliance

# --- Optional SMTP for e-mailing passes ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Backups ---
BACKUP_DIR=/srv/backups/guestwifi
BACKUP_KEEP_DAYS=30
